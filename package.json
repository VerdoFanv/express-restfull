{
  "name": "express-restfull",
  "version": "1.0.0",
  "description": "Production-oriented REST API with Express — clean architecture, JWT auth, Redis caching, and RabbitMQ events",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "lint": "eslint src test --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest --testPathPatterns=test/unit",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest --testPathPatterns=test/integration",
    "test:cover": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:push": "prisma db push",
    "ci": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@prisma/client": "^6.12.0",
    "amqplib": "^0.10.8",
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.1",
    "jsonwebtoken": "^9.0.2",
    "ms": "^2.1.3",
    "pino": "^9.7.0",
    "prisma": "^6.12.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@types/amqplib": "^0.10.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/ms": "^2.1.0",
    "@types/node": "^22.16.5",
    "@types/supertest": "^6.0.3",
    "eslint": "^10.8.0",
    "jest": "^30.4.2",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.12",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0"
  },
  "overrides": {
    "brace-expansion": "5.0.8"
  }
}
