APP_ENV=development
APP_PORT=8080
API_KEY=dev-api-key
LOG_LEVEL=info

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=express_restfull
DB_SSLMODE=disable
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/express_restfull?schema=public

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=express_restfull.events
RABBITMQ_QUEUE=express_restfull.product.created

JWT_SECRET=dev-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
BCRYPT_COST=10
PRODUCT_CACHE_TTL=5m
